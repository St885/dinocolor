# =============================================================================
# DinoColor — variables de entorno (PLANTILLA)
#
# Copia este archivo a `.env` y rellena los valores. `.env` está en .gitignore:
# NUNCA se sube al repositorio.
#
#     cp .env.example .env
#
# Sin `.env`, el juego funciona igual: arranca, se juega entero y la pantalla de
# acceso ofrece el modo invitado con un aviso claro de que el login con cuenta
# aún no está configurado. La build sigue verde.
#
# Guía paso a paso para obtener estos valores: docs/AUTH.md
# =============================================================================

# --- Firebase (obligatorias para activar el acceso con cuenta) ---------------
# Consola de Firebase → Configuración del proyecto → Tus apps → App web → SDK.
#
# NOTA: estos valores NO son secretos. La configuración web de Firebase viaja en
# el cliente por diseño y Google la considera pública; lo que protege el proyecto
# son los "Dominios autorizados" de Authentication y las reglas del backend.
# Viven en `.env` para no atar el repositorio a un proyecto concreto y para poder
# tener entornos distintos (desarrollo / producción) sin tocar código.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- Firebase (opcionales) ---------------------------------------------------
# No hacen falta para Auth. Rellénalas si algún día se usa Storage o Messaging.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# --- Interruptores de proveedor ---------------------------------------------
# Por defecto ambos se anuncian cuando Firebase está configurado. Pon `false`
# para ocultar un botón mientras ese proveedor no esté dado de alta — más honesto
# que enseñar un botón que devuelve "operación no permitida" al pulsarlo.
#
# Apple exige, ADEMÁS de activarlo en Firebase, una cuenta del Apple Developer
# Program de pago y configurar un Services ID + clave privada. Ver docs/AUTH.md.
VITE_AUTH_GOOGLE_ENABLED=true
VITE_AUTH_APPLE_ENABLED=true
